# Copy this file to .env and fill in the values.
# When using Docker Compose, most of these are set from docker-compose.yml;
# only override here what you want to change.

# --- Database ---
# For local dev (non-Docker):
DATABASE_URL=postgresql://postgres:password@localhost:5432/ufms
# For Docker Compose (set automatically via docker-compose.yml env overrides):
# DATABASE_URL=postgresql://postgres:secret@db:5432/ufms

# --- Postgres (Docker only) ---
POSTGRES_PASSWORD=secret

# --- JWT ---
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Email (SendGrid / SMTP) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
EMAIL_FROM=no-reply@ufms.example.com

# --- App ---
APP_ENV=development
ALLOWED_ORIGINS=["http://localhost:8000","http://localhost:3000"]

# --- First admin account (seed_admin script) ---
ADMIN_EMAIL=admin@ufms.hehe
ADMIN_PASSWORD=Admin1234!
ADMIN_NAME=System Administrator
